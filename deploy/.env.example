# 复制到服务器 /opt/staffdeck/.env，填写真实值后再启动
STAFFDECK_IMAGE=ghcr.io/hnscdg/staffdeck:latest

# 运行时
ULTRARAG_DATA_DIR=/data
ULTRARAG_HOST=0.0.0.0
ULTRARAG_PORT=5173
STAFFDECK_HEADLESS=true
STAFFDECK_INSTALL_ROOT=/app
STAFFDECK_DISTRIBUTION_MANIFEST=/app/distribution/manifest.json

# 生产环境关闭演示数据（发行版默认初始化 5 个基础岗位）
demo_seed_enabled=false

# 安全密钥：上线前生成，勿提交到仓库
# openssl rand -hex 32
app_secret=CHANGE_ME
channel_secret=CHANGE_ME
public_api_key_pepper=CHANGE_ME
